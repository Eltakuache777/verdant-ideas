# Copy this file to .env.local and fill in real values.
# Any var prefixed NEXT_PUBLIC_ is inlined into the client bundle at BUILD
# time — set it in your deploy platform's build environment, not just the
# runtime environment, or it won't take effect.

# The app's own real public URL. Required in production: without it,
# robots.txt, sitemap.xml, and canonical/OG URLs silently fall back to
# http://localhost:3000.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Stripe (subscription billing + one-time merch checkout)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=
STRIPE_DAYPASS_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Firebase Admin SDK (server-side only — service account credentials)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (design image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Printful (manufacturing + fulfillment)
PRINTFUL_API_KEY=
# Optional — only needed if your Printful account has multiple stores.
PRINTFUL_STORE_ID=

# OpenAI (AI design generation in Verdant Forge)
OPENAI_API_KEY=

# The one account allowed to publish real products to the public shop
# (turning a design into a catalog listing creates a real Printful sync
# product and instantly lists it for sale). Must match the email of your own
# Firebase Auth account — without this set, that action is blocked for
# everyone, including you.
ADMIN_EMAIL=
